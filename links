<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Links | BPHP Disdikbud HSS</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background:
                radial-gradient(circle at 20% 20%, rgba(0, 119, 255, 0.18), transparent 30%),
                radial-gradient(circle at 80% 80%, rgba(0, 174, 255, 0.12), transparent 30%),
                #050b14;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Grid teknologi */
        body::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(0, 140, 255, 0.07) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 140, 255, 0.07) 1px, transparent 1px);
            background-size: 45px 45px;
            mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
            pointer-events: none;
        }

        /* Garis dekoratif */
        .line {
            position: absolute;
            background: linear-gradient(90deg, transparent, #008cff, transparent);
            height: 1px;
            width: 100%;
            opacity: 0.5;
        }

        .line.top {
            top: 12%;
        }

        .line.bottom {
            bottom: 12%;
        }

        .container {
            width: min(92%, 520px);
            position: relative;
            z-index: 2;
        }

        .card {
            background: rgba(7, 17, 30, 0.88);
            border: 1px solid rgba(0, 153, 255, 0.45);
            border-radius: 20px;
            padding: 42px 32px;
            text-align: center;
            box-shadow:
                0 0 30px rgba(0, 119, 255, 0.12),
                inset 0 0 30px rgba(0, 119, 255, 0.03);
            backdrop-filter: blur(12px);
        }

        .logo {
            width: 70px;
            height: 70px;
            margin: 0 auto 22px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0077ff, #00b7ff);
            box-shadow: 0 0 25px rgba(0, 145, 255, 0.35);
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .tag {
            display: inline-block;
            font-size: 11px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #4db8ff;
            margin-bottom: 12px;
            font-weight: bold;
        }

        h1 {
            font-size: clamp(25px, 6vw, 34px);
            line-height: 1.2;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .description {
            color: #9eb4ca;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .link-button {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            width: 100%;
            padding: 18px 20px;
            border-radius: 12px;
            text-decoration: none;
            color: white;
            background: linear-gradient(135deg, #006eff, #008fdc);
            border: 1px solid rgba(92, 199, 255, 0.5);
            box-shadow: 0 8px 25px rgba(0, 110, 255, 0.25);
            font-size: 15px;
            font-weight: 600;
            transition: all 0.25s ease;
        }

        .link-button:hover {
            transform: translateY(-3px);
            box-shadow:
                0 12px 30px rgba(0, 119, 255, 0.4),
                0 0 20px rgba(0, 174, 255, 0.2);
        }

        .link-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            background: rgba(255,255,255,0.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .arrow {
            font-size: 20px;
            opacity: 0.8;
        }

        .footer {
            margin-top: 28px;
            color: #61788e;
            font-size: 11px;
            letter-spacing: 1px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 15px;
            font-size: 11px;
            color: #6fd0ff;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #00b7ff;
            box-shadow: 0 0 10px #00b7ff;
        }

        @media (max-width: 480px) {
            .card {
                padding: 34px 22px;
            }

            h1 {
                font-size: 26px;
            }
        }
    </style>
</head>

<body>

    <div class="line top"></div>
    <div class="line bottom"></div>

    <main class="container">

        <section class="card">

            <div class="logo">
                BP
            </div>

            <div class="tag">
                DIGITAL PORTAL
            </div>

            <h1>
                Biodata Peserta Kegiatan
            </h1>

            <p class="description">
                Silakan mengakses formulir biodata peserta melalui tautan
                berikut untuk melakukan pengisian data kegiatan.
            </p>

            <a
                class="link-button"
                href="https://script.google.com/macros/s/AKfycbyDX2i3fTJwhhqYe_38rulDTBoNmsmM7AH2PkDKu9mBL5mQkCjWutbcIsr8FP5rEKNkJA/exec"
                target="_blank"
                rel="noopener noreferrer"
            >
                <span class="link-icon">↗</span>

                <span style="flex:1; text-align:left;">
                    Isi Biodata Peserta
                </span>

                <span class="arrow">→</span>
            </a>

            <div class="status">
                <span class="status-dot"></span>
                SISTEM ONLINE
            </div>

            <div class="footer">
                BPHP DISDIKBUD HSS
            </div>

        </section>

    </main>

</body>
</html>
